{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/airo-assets/:type/:key*",
      "destination": "/api/airo-assets?type=:type&key=:key*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
