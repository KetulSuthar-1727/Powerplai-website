{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",

  "rewrites": [
    {
      "source": "/airo-assets/:path*",
      "destination": "/api/airo-assets?key=:path*"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}